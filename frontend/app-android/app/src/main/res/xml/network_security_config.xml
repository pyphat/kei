<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- shortcut: Android can't scope cleartext to private IP ranges; replaced by pinned local HTTPS in the hardening milestone -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
